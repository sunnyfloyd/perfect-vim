# Files used inside the Linux container must keep LF line endings,
# even when Git for Windows checks them out with core.autocrlf=true.
*.sh        text eol=lf
*.lua       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
Dockerfile  text eol=lf

# Windows scripts
*.ps1       text eol=crlf
*.cmd       text eol=crlf
